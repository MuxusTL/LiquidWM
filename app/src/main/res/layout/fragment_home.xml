<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <!-- App Name: Big on left, NO subtext as requested -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="24dp" />

        <!-- Card 1: Select Photo (Thêm ảnh) -->
        <LinearLayout
            android:id="@+id/cardPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_photo_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_photo_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp" />

            <!-- Solid Black Button with White Text -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSelectPhoto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_black"
                android:text="@string/btn_select_photo"
                android:textColor="@color/btn_black_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Card 2: Select Video (Video Watermark) -->
        <LinearLayout
            android:id="@+id/cardVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_video_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_video_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp" />

            <!-- Light Gray Button with Black Text -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSelectVideo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_light"
                android:text="@string/btn_select_video"
                android:textColor="@color/btn_light_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Section: Common Tools (Công cụ thường dùng) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_common_tools"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:layout_marginBottom="14dp" />

        <!-- Tool Item 1: My Presets -->
        <LinearLayout
            android:id="@+id/btnToolMyPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_my_presets"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:id="@+id/tvPresetsCountDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã lưu 5 cấu hình · Lưu, áp dụng và chia sẻ"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Tool Item 2: Explore Presets -->
        <LinearLayout
            android:id="@+id/btnToolExplore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_explore_presets"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_explore_presets_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Bottom Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_footer_note"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/inter"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
