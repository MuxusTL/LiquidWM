<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/editorTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBackEditor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editor_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editor_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/topBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle"
        app:layout_constraintTop_toBottomOf="@id/editorTopBar" />

    <!-- Scrollable Editor Controls -->
    <ScrollView
        android:id="@+id/editorScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomExportBar"
        app:layout_constraintTop_toBottomOf="@id/topBarDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Card: Live Preview (Xem trước hiệu ứng động) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_card_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_card_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp" />

                <!-- Full Media Preview Container (Supports any aspect ratio, no cropping) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/previewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#111111">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- Background Image / Video Target: Full photo with adjustViewBounds -->
                        <ImageView
                            android:id="@+id/ivPreviewMedia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:maxHeight="480dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/bg_button_light" />

                        <!-- Custom Liquid Glass View with Refraction and Specular Rim Highlight -->
                        <dev.liquidplus.watermark.ui.view.LiquidGlassView
                            android:id="@+id/liquidGlassWatermark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="14dp" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Pause/Resume Live Preview Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTogglePreview"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_light"
                    android:text="@string/btn_pause_preview"
                    android:textColor="@color/btn_light_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:textAllCaps="false"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_note"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <!-- Card: Watermark Position & Size (Vị trí & Kích thước Watermark) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_watermark_position"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <!-- 3 Modes: Bên trái, Ở giữa, Bên phải -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_button_light"
                    android:orientation="horizontal"
                    android:padding="3dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/btnAlignLeft"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segmented_inactive"
                        android:gravity="center"
                        android:text="@string/pos_left"
                        android:textColor="@color/btn_light_text"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnAlignCenter"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segmented_active"
                        android:gravity="center"
                        android:text="@string/pos_center"
                        android:textColor="@color/btn_black_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnAlignRight"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segmented_inactive"
                        android:gravity="center"
                        android:text="@string/pos_right"
                        android:textColor="@color/btn_light_text"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Watermark Size Slider -->
                <TextView
                    android:id="@+id/tvWatermarkSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_watermark_size"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <SeekBar
                    android:id="@+id/sbWatermarkSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="140"
                    android:progress="100"
                    android:progressTint="@color/btn_black"
                    android:thumbTint="@color/btn_black"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Card: Custom Image / Logo Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_custom_image"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:id="@+id/tvLogoStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_image_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="12dp" />

                <!-- Logo Picker Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Plus Button for User Upload -->
                    <FrameLayout
                        android:id="@+id/btnAddCustomLogo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_button"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_add"
                            app:tint="@color/text_primary" />
                    </FrameLayout>

                    <!-- Horizontal Brand Logos Recycler -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBrandLogos"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- Section: Logo Position (Bên trái / Bên phải) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_image_position"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_button_light"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/btnPosLeft"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segmented_active"
                        android:gravity="center"
                        android:text="@string/pos_left"
                        android:textColor="@color/btn_black_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnPosRight"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segmented_inactive"
                        android:gravity="center"
                        android:text="@string/pos_right"
                        android:textColor="@color/btn_light_text"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card: Device Text & Camera Specs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Device Model -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_device_text"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <EditText
                    android:id="@+id/etDeviceModel"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_device_text"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/btnDetectDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_auto_detect_device"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="18dp" />

                <!-- Camera Parameters (EXIF) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_camera_params"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <EditText
                    android:id="@+id/etCameraParams"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_camera_params"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/btnReadExif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_read_exif"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="18dp" />

                <!-- Date & Time -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_date_time"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />

                <EditText
                    android:id="@+id/etDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_date_time"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:inputType="text" />
            </LinearLayout>

            <!-- Card: Liquid Glass Optics Tuning -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_glass_tuning"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:layout_marginBottom="12dp" />

                <!-- Blur Slider -->
                <TextView
                    android:id="@+id/tvBlurLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_blur"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter" />
                <SeekBar
                    android:id="@+id/sbBlur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="60"
                    android:progressTint="@color/btn_black"
                    android:thumbTint="@color/btn_black"
                    android:layout_marginBottom="14dp" />

                <!-- Refraction Slider -->
                <TextView
                    android:id="@+id/tvRefractionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_refraction"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter" />
                <SeekBar
                    android:id="@+id/sbRefraction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="75"
                    android:progressTint="@color/btn_black"
                    android:thumbTint="@color/btn_black"
                    android:layout_marginBottom="14dp" />

                <!-- Rim Specular Slider -->
                <TextView
                    android:id="@+id/tvRimLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_rim_light"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter" />
                <SeekBar
                    android:id="@+id/sbRimLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="85"
                    android:progressTint="@color/btn_black"
                    android:thumbTint="@color/btn_black" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Sticky Export Bar -->
    <LinearLayout
        android:id="@+id/bottomExportBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnExportFile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_black"
            android:text="@string/btn_export"
            android:textColor="@color/btn_black_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
