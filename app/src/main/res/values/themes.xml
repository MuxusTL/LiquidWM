<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.LiquidWatermark" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/btn_black</item>
        <item name="colorPrimaryVariant">@color/btn_black</item>
        <item name="colorOnPrimary">@color/btn_black_text</item>
        <item name="colorSecondary">@color/btn_black</item>
        <item name="colorSecondaryVariant">@color/btn_black</item>
        <item name="colorOnSecondary">@color/btn_black_text</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status Bar & Nav Bar -->
        <item name="android:statusBarColor">@color/bg_app</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg_bottom_nav</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Typography: Inter font default across the whole app -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
</resources>
