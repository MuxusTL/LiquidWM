<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/explore_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/explore_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Style Card 1: Leica Master Pill -->
        <LinearLayout
            android:id="@+id/cardStyleLeica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_brand_leica" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/style_leica"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/style_leica_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApplyLeica"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_light"
                android:text="@string/btn_apply_preset"
                android:textColor="@color/btn_light_text"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Style Card 2: Hasselblad Natural Color -->
        <LinearLayout
            android:id="@+id/cardStyleHasselblad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="#111111"
                    android:padding="4dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_brand_hasselblad" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/style_hasselblad"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/style_hasselblad_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApplyHasselblad"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_light"
                android:text="@string/btn_apply_preset"
                android:textColor="@color/btn_light_text"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Style Card 3: Apple Minimal Glass -->
        <LinearLayout
            android:id="@+id/cardStyleApple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="#111111"
                    android:padding="4dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_brand_apple" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/style_apple"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/style_apple_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApplyApple"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_light"
                android:text="@string/btn_apply_preset"
                android:textColor="@color/btn_light_text"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
